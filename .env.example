# Portfolio Environment Configuration
# Copy this file to .env.local for local overrides

# Production site base URL (used for canonical URLs, sitemaps, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL="https://portfolio-mihir-shekhar-gupta.vercel.app"

# Optional Contact Form Webhook (e.g. Discord, Slack, or Zapier endpoint)
# If left empty, contact form submissions validate locally and log a success message without third-party email delivery
CONTACT_WEBHOOK_URL=""
